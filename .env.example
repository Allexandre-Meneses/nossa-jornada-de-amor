# Senha usada para acessar /admin
ADMIN_PASSWORD=12345678

# Banco Redis da Vercel/Upstash para armazenar as respostas
# A integração da Vercel pode criar estas variáveis automaticamente.
KV_REST_API_URL=https://seu-banco.upstash.io
KV_REST_API_TOKEN=seu-token

# Também são aceitos os nomes padrão do Upstash:
# UPSTASH_REDIS_REST_URL=https://seu-banco.upstash.io
# UPSTASH_REDIS_REST_TOKEN=seu-token
