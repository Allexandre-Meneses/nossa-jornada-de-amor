# Escolha apenas um canal: email ou telegram
NOTIFICATION_CHANNEL=email

# Opção 1: e-mail via Resend (https://resend.com)
RESEND_API_KEY=re_xxxxxxxxx
NOTIFICATION_EMAIL=seu-email@exemplo.com
# Depois de validar um domínio no Resend, substitua o remetente abaixo.
NOTIFICATION_FROM_EMAIL=Nossa Jornada <onboarding@resend.dev>

# Opção 2: Telegram (preencha se NOTIFICATION_CHANNEL=telegram)
TELEGRAM_BOT_TOKEN=0000000000:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=000000000
